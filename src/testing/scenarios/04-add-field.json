{
  "name": "add-field",
  "description": "Create a new field via flow (name + city)",
  "steps": [
    {
      "send": "agregar campo Don Pedro",
      "expect": {
        "responseContains": [
          "ubicar"
        ],
        "hasButtons": true
      }
    },
    {
      "tap": "flow_field_loc_city",
      "expect": {
        "responseContains": [
          "localidad"
        ]
      }
    },
    {
      "send": "Pergamino",
      "expect": {
        "responseContains": [
          "Confirmar",
          "Pedro"
        ]
      }
    },
    {
      "tap": "flow_confirm",
      "expect": {
        "responseContains": [
          "creado"
        ],
        "dbRowCount": {
          "table": "fields",
          "count": 1
        }
      }
    }
  ]
}
