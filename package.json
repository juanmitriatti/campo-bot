{
  "name": "campo-bot",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/app.js",
  "scripts": {
    "start": "node dist/app.js",
    "dev": "tsx src/app.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "npx tsx src/testing/run-eval.ts --all",
    "eval:verbose": "npx tsx src/testing/run-eval.ts --all --verbose",
    "qa:p0:atomicity": "npx tsx src/testing/qa-p0/qa-p0-atomicity.ts",
    "qa:p0:channel": "npx tsx src/testing/qa-p0/qa-p0-channel-verify.ts",
    "qa:p0:export": "npx tsx src/testing/qa-p0/qa-p0-export-delete.ts",
    "qa:p0:billing": "npx tsx src/testing/qa-p0/qa-p0-billing.ts",
    "qa:p0": "npm run qa:p0:atomicity && npm run qa:p0:channel && npm run qa:p0:export && npm run qa:p0:billing"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@sentry/node": "^10.51.0",
    "@sentry/profiling-node": "^10.51.0",
    "@types/multer": "^2.1.0",
    "archiver": "^7.0.1",
    "axios": "^1.13.6",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "pdfkit": "^0.17.2",
    "pg": "^8.19.0",
    "resend": "^6.12.2",
    "sharp": "^0.34.5",
    "svg-to-pdfkit": "^0.1.8",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  }
}
